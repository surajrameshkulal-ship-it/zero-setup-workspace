APP_NAME=CodeDNA AI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

DATABASE_URL=postgresql+psycopg://codedna:codedna@postgres:5432/codedna
REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

AI_REVIEW_ENABLED=true
AI_PROVIDER=groq
AI_DAILY_REQUEST_LIMIT=1000
AI_MONTHLY_REQUEST_LIMIT=20000
AI_MAX_FILES_PER_REVIEW=40
AI_MAX_DIFF_CHARS=80000
AI_REVIEW_TIMEOUT_SECONDS=30
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# AI_PROVIDER (above) selects the router provider: groq (default) | openai | anthropic | auto.
# The router never falls back to Ollama automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_API_BASE_URL=https://api.github.com

SEMGREP_BINARY=semgrep
SEMGREP_CONFIG=auto
SEMGREP_TIMEOUT_SECONDS=120

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
