# =============================================================================
# CodeDNA AI — PRODUCTION environment template
# Copy to .env.production (or set these as secrets in Railway/Render) and fill in.
# Never commit the filled-in file. Values marked (required) MUST be set.
# =============================================================================

# --- Application ---------------------------------------------------------------
APP_NAME=CodeDNA AI
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# (required) Long random string, >= 16 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT lifetime in minutes (1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# (required) Comma-separated EXACT frontend origin(s). No trailing slash, no "*".
# Example: https://app.yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# --- Database (required) -------------------------------------------------------
# Managed Postgres connection string. Note the psycopg driver prefix.
# Railway/Render give you a URL like postgres://...  -> rewrite the scheme to:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# If you run Postgres yourself via docker-compose.prod.yml, also set these
# (they configure the postgres container and must match DATABASE_URL):
POSTGRES_DB=codedna
POSTGRES_USER=codedna
POSTGRES_PASSWORD=

# --- Redis (required) ----------------------------------------------------------
# Used as both the Celery broker and result backend.
# Example (managed): rediss://default:PASSWORD@HOST:6379/0
REDIS_URL=redis://redis:6379/0

# --- AI review provider --------------------------------------------------------
# Set AI_REVIEW_ENABLED=false to disable AI review entirely.
AI_REVIEW_ENABLED=true
AI_PROVIDER=groq
AI_REVIEW_TIMEOUT_SECONDS=60
AI_DAILY_REQUEST_LIMIT=1000
AI_MONTHLY_REQUEST_LIMIT=20000
AI_MAX_FILES_PER_REVIEW=40
AI_MAX_DIFF_CHARS=80000

# Groq (recommended for cloud). Required when AI_PROVIDER=groq and AI is enabled.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (alternative). Required when AI_PROVIDER=openai and AI is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama (self-hosted models only; usually NOT used in cloud).
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_TIMEOUT_SECONDS=120

# --- GitHub App (required for live scanning) -----------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the PEM with literal \n escapes on a single line, e.g.
#   "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_PRIVATE_KEY=
# (required) Must match the webhook secret configured in the GitHub App.
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# --- Static analysis -----------------------------------------------------------
SEMGREP_BINARY=semgrep
SEMGREP_CONFIG=auto
SEMGREP_TIMEOUT_SECONDS=120

# --- Frontend (BUILD-TIME, not runtime) ----------------------------------------
# NEXT_PUBLIC_* is inlined when the frontend image is built. Pass it as a build
# arg to the frontend image (see docker-compose.prod.yml / the deployment guide).
# Example: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=
